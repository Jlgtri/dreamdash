        {
            "type": "shell",
            "label": "pub_get",
            "command": "${command:pub.get}",
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "type": "shell",
            "label": "build_runner",
            "command": "dart",
            "args": [
                "run",
                "build_runner",
                "watch",
                "--delete-conflicting-outputs",
                "--low-resources-mode",
                "--use-polling-watcher"
            ],
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            // "dependsOn": "pub_get",
            "problemMatcher": [
                "$dart-build_runner"
            ],
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Aider",
            "type": "shell",
            "command": "aider",
            "args": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "close": false,
                "showReuseMessage": false
            },
            "promptOnClose": true,
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen",
                "instanceLimit": 1
            },
            "options": {
                // https://aider.chat/docs/config/dotenv.html
