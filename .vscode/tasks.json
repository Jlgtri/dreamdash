                    // "AIDER_MODEL": "gemini/gemini-1.5-pro-latest",
                    // Model Settings
                    "AIDER_MAP_TOKENS": "1024",
                    "AIDER_CACHE_PROMPTS": "true",
                    // Output Settings
                    "AIDER_DARK_MODE": "true",
                    // Git Settings
                    "AIDER_DIRTY_COMMITS": "false",
                    "AIDER_ATTRIBUTE_COMMIT_MESSAGE_AUTHOR": "true",
                    // Other Settings
                    "AIDER_YES": "true"
